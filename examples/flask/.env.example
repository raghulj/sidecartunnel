# Copy to .env before running. Every value below is an obvious placeholder and must be
# replaced. Generate real ones with:
#
#     openssl rand -hex 32
#
# Secrets belong in a secret manager or a Docker secret, never in a repository, an image
# layer or a Dockerfile. See docs/17-production-readiness.md §3.

# --- Shared with the gateway -------------------------------------------------------
# Minimum 32 bytes each, and the two must be different values. A single secret means
# anyone who can read a webhook signature can forge a fleet-wide disconnect.
ST_WEBHOOK_SECRETS=REPLACE-ME-webhook-secret-at-least-32-bytes
ST_CONTROL_SECRET=REPLACE-ME-control-secret-at-least-32-bytes

# Bearer token for the admin API. When unset, the authenticated routes return 404 rather
# than being open. The admin listener is never published.
ST_ADMIN_TOKEN=REPLACE-ME-admin-bearer-token

# Exact origins, comma separated. No wildcards, no suffix matching. The gateway refuses
# to start when this is empty, and will start happily with the wrong value.
ST_ALLOWED_ORIGINS=http://localhost:8080

# --- Application -------------------------------------------------------------------
FLASK_SECRET_KEY=REPLACE-ME-flask-session-signing-key
REDIS_URL=redis://redis:6379/3
ST_BUS_PREFIX=st:

# Seconds until the gateway closes for re-authorization. 21600 is six hours, the
# gateway's max_expiry default. This is a reconnect interval, not a session lifetime:
# every expiry costs a full re-handshake per connection.
ST_EXPIRES_IN=21600

ST_WS_URL=/ws
DEMO_DATABASE=/tmp/sidecartunnel-demo.db
